@{
    ViewData["Title"] = "Monitoring Gateway";
    Layout = "_PreviewLayout";
}

<div class="preview-shell">
    <header class="preview-header">
        <div class="header-brand">
            <div>
                <div class="header-title">Gateway Monitoring</div>
                <div class="header-sub">Visualisasi posisi gateway &middot; Fabrikasi</div>
            </div>
        </div>

        <div class="header-right">
            <div class="legend" aria-label="Keterangan status">
                <span class="legend-item"><span class="legend-dot online"></span>Online</span>
                <span class="legend-item"><span class="legend-dot offline"></span>Offline</span>
                <span class="legend-item"><span class="legend-dot unknown"></span>Tidak diketahui</span>
            </div>
            <time id="clock" class="header-clock" aria-live="off"></time>
        </div>
    </header>

    <div class="preview-body">
        <main class="preview-main">
            <div id="preview-viewport"></div>
            <div id="callout-layer" aria-live="polite"></div>

            <section class="gateway-card" id="gateway-card" aria-label="Daftar gateway">
                <header class="gateway-card__head">
                    <h2>Daftar Gateway</h2>
                    <p><strong id="gateway-count">0</strong> gateway &middot; <span id="connection-state" class="conn unknown">menghubungkan&hellip;</span></p>
                </header>
                <div class="gateway-list" id="gateway-list" role="list"></div>
                <footer class="gateway-card__foot">Klik gateway untuk fokus ke lokasi</footer>
            </section>

            <div class="preview-alert" id="preview-alert" role="alert" hidden></div>

            <div class="preview-loading" id="preview-loading">
                <div class="loading-card">
                    <h2>Memuat scene fabrikasi</h2>
                    <div class="load-row" data-load="factoryBase">
                        <span>Factory Base</span>
                        <progress max="100" value="0"></progress>
                        <em>menunggu</em>
                    </div>
                    <div class="load-row" data-load="machinery">
                        <span>Machinery</span>
                        <progress max="100" value="0"></progress>
                        <em>menunggu</em>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/preview.js" asp-append-version="true"></script>
}
